begin;
create table public.amcf_documents (
 id uuid primary key default gen_random_uuid(),
 case_id uuid not null references public.amcf_cases(id),
 contact_id uuid references public.amcf_contacts(id),
 title text not null check(char_length(title) between 2 and 200),
 category text not null default 'outro' check(category in ('procuracao','processo','laudo','exame','quesitos','contrato','comprovante','outro')),
 document_date date,
 storage_path text not null unique,
 file_name text not null check(char_length(file_name) between 1 and 180),
 mime_type text not null,
 size_bytes bigint not null check(size_bytes > 0 and size_bytes <= 20971520),
 uploaded_by uuid not null default auth.uid() references public.amcf_members(id),
 created_at timestamptz not null default now()
);
create index amcf_documents_case_idx on public.amcf_documents(case_id, created_at desc);
create index amcf_documents_category_idx on public.amcf_documents(category);
create table public.amcf_proposals (
 id uuid primary key default gen_random_uuid(),
 title text not null check(char_length(title) between 3 and 200),
 contact_id uuid not null references public.amcf_contacts(id),
 opportunity_id uuid references public.amcf_opportunities(id),
 case_id uuid references public.amcf_cases(id),
 service text not null check(char_length(service) between 2 and 160),
 description text not null default '' check(char_length(description) <= 4000),
 amount_cents bigint not null check(amount_cents >= 0),
 valid_until date,
 status text not null default 'draft' check(status in ('draft','sent','accepted','refused','expired')),
 responsible_id uuid not null default auth.uid() references public.amcf_members(id),
 notes text not null default '' check(char_length(notes) <= 2000),
 created_by uuid not null default auth.uid() references public.amcf_members(id),
 created_at timestamptz not null default now(),
 updated_at timestamptz not null default now()
);
create index amcf_proposals_status_idx on public.amcf_proposals(status, valid_until);
create index amcf_proposals_contact_idx on public.amcf_proposals(contact_id);
create table public.amcf_receivables (
 id uuid primary key default gen_random_uuid(),
 description text not null check(char_length(description) between 3 and 200),
 contact_id uuid not null references public.amcf_contacts(id),
 case_id uuid references public.amcf_cases(id),
 proposal_id uuid references public.amcf_proposals(id),
 amount_cents bigint not null check(amount_cents > 0),
 due_on date not null,
 status text not null default 'pending' check(status in ('pending','paid','overdue','cancelled')),
 paid_on date,
 payment_method text,
 responsible_id uuid not null default auth.uid() references public.amcf_members(id),
 notes text not null default '' check(char_length(notes) <= 2000),
 created_by uuid not null default auth.uid() references public.amcf_members(id),
 created_at timestamptz not null default now(),
 updated_at timestamptz not null default now(),
 check ((status = 'paid') = (paid_on is not null))
);
create index amcf_receivables_due_idx on public.amcf_receivables(due_on, status);
create index amcf_receivables_contact_idx on public.amcf_receivables(contact_id);

alter table public.amcf_documents enable row level security;
alter table public.amcf_proposals enable row level security;
alter table public.amcf_receivables enable row level security;

create policy documents_read on public.amcf_documents for select to authenticated using (public.amcf_can_case(case_id));
create policy documents_insert on public.amcf_documents for insert to authenticated with check (public.amcf_can_case(case_id) and uploaded_by = auth.uid());
create policy documents_update on public.amcf_documents for update to authenticated using (public.amcf_can_case(case_id)) with check (public.amcf_can_case(case_id));
create policy documents_delete on public.amcf_documents for delete to authenticated using (public.amcf_can_case(case_id) and (public.amcf_is_manager() or uploaded_by = auth.uid()));
create policy proposals_read on public.amcf_proposals for select to authenticated using (public.amcf_is_manager());
create policy proposals_insert on public.amcf_proposals for insert to authenticated with check (public.amcf_is_manager() and created_by = auth.uid());
create policy proposals_update on public.amcf_proposals for update to authenticated using (public.amcf_is_manager()) with check (public.amcf_is_manager());
create policy proposals_delete on public.amcf_proposals for delete to authenticated using (public.amcf_is_manager());
create policy receivables_read on public.amcf_receivables for select to authenticated using (public.amcf_is_manager());
create policy receivables_insert on public.amcf_receivables for insert to authenticated with check (public.amcf_is_manager() and created_by = auth.uid());
create policy receivables_update on public.amcf_receivables for update to authenticated using (public.amcf_is_manager()) with check (public.amcf_is_manager());
create policy receivables_delete on public.amcf_receivables for delete to authenticated using (public.amcf_is_manager());

create trigger guard_row before insert or update on public.amcf_documents for each row execute function public.amcf_guard_row();
create trigger guard_row before insert or update on public.amcf_proposals for each row execute function public.amcf_guard_row();
create trigger guard_row before insert or update on public.amcf_receivables for each row execute function public.amcf_guard_row();
create trigger audit_row after insert or update or delete on public.amcf_documents for each row execute function public.amcf_audit_row();
create trigger audit_row after insert or update or delete on public.amcf_proposals for each row execute function public.amcf_audit_row();
create trigger audit_row after insert or update or delete on public.amcf_receivables for each row execute function public.amcf_audit_row();

create function public.amcf_report() returns jsonb language sql stable security invoker set search_path = public as $$
 select jsonb_build_object(
  'opportunities', (select count(*) from public.amcf_opportunities),
  'opportunities_won', (select count(*) from public.amcf_opportunities o join public.amcf_pipeline_stages s on s.id = o.stage_id where s.outcome = 'won'),
  'opportunities_value', (select coalesce(sum(amount_cents), 0) from public.amcf_opportunity_values),
  'opportunities_by_stage', (select coalesce(jsonb_agg(x), '[]') from (select s.name, s.position, count(o.id) as count from public.amcf_pipeline_stages s left join public.amcf_opportunities o on o.stage_id = s.id group by s.name, s.position order by s.position) x),
  'cases_open', (select count(*) from public.amcf_cases c join public.amcf_case_stages s on s.id = c.stage_id where not s.terminal and c.archived_at is null),
  'cases_by_stage', (select coalesce(jsonb_agg(y), '[]') from (select s.name, s.position, count(c.id) as count from public.amcf_case_stages s left join public.amcf_cases c on c.stage_id = s.id and c.archived_at is null group by s.name, s.position order by s.position) y),
  'tasks_pending', (select count(*) from public.amcf_tasks where status in ('pending','in_progress')),
  'tasks_overdue', (select count(*) from public.amcf_tasks where status in ('pending','in_progress') and due_on < (now() at time zone 'America/Bahia')::date),
  'proposals_by_status', (select coalesce(jsonb_agg(z), '[]') from (select status, count(*) as count, coalesce(sum(amount_cents), 0) as total from public.amcf_proposals group by status) z),
  'finance', jsonb_build_object(
   'received', (select coalesce(sum(amount_cents), 0) from public.amcf_receivables where status = 'paid'),
   'pending', (select coalesce(sum(amount_cents), 0) from public.amcf_receivables where status = 'pending' and due_on >= (now() at time zone 'America/Bahia')::date),
   'overdue', (select coalesce(sum(amount_cents), 0) from public.amcf_receivables where status = 'pending' and due_on < (now() at time zone 'America/Bahia')::date),
   'next_due', (select coalesce(jsonb_agg(n), '[]') from (select id, description, due_on, amount_cents from public.amcf_receivables where status = 'pending' order by due_on limit 5) n)
  )
 )
$$;
revoke all on function public.amcf_report() from public, anon;
grant execute on function public.amcf_report() to authenticated;
revoke all on public.amcf_documents, public.amcf_proposals, public.amcf_receivables from anon;
grant select, insert, update, delete on public.amcf_documents, public.amcf_proposals, public.amcf_receivables to authenticated;
commit;